---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import PostCard from '../../../components/PostCard.astro'; import { categorySlug, getPublishedPosts } from '../../../lib/posts';
export async function getStaticPaths() { const posts = await getPublishedPosts(); return [...new Set(posts.map((post) => post.data.category))].map((category) => ({ params: { category: categorySlug(category) }, props: { category, posts: posts.filter((post) => post.data.category === category) } })); }
const { category, posts } = Astro.props;
---
<BaseLayout title={`${category} · Blog`}><div class="page-intro"><h1>{category}</h1><p>Posts filed under this topic.</p></div>{posts.map((post) => <PostCard {post} />)}</BaseLayout>
