---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search · Your Name"><div class="page-intro"><h1>Search</h1><p>Search every published article locally in your browser.</p></div><div id="search"></div></BaseLayout>
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>window.addEventListener('DOMContentLoaded', () => new PagefindUI({ element: '#search', showSubResults: true, resetStyles: false }));</script>
