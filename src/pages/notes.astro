---
import BaseLayout from '../layouts/BaseLayout.astro'; import PostCard from '../components/PostCard.astro'; import { getPublishedPosts } from '../lib/posts'; const posts = (await getPublishedPosts()).filter((post) => post.data.category === 'Notes');
---
<BaseLayout title="Notes · Your Name"><div class="page-intro"><h1>Notes</h1><p>Short learning notes and useful references.</p></div>{posts.length ? posts.map((post) => <PostCard {post} />) : <p>No notes yet. Add a Markdown file with <code>category: Notes</code>.</p>}</BaseLayout>
