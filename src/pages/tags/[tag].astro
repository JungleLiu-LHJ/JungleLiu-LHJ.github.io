---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PostCard from '../../components/PostCard.astro'; import { getPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() { const posts = await getPublishedPosts(); return [...new Set(posts.flatMap((post) => post.data.tags))].map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } })); }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag} · Your Name`}><div class="page-intro"><h1>#{tag}</h1><p>Posts tagged with {tag}.</p></div>{posts.map((post) => <PostCard {post} />)}</BaseLayout>
