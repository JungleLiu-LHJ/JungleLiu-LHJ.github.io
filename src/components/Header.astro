---
const { pathname } = Astro.url;
const nav = [
  ['Blog', '/blog'], ['Projects', '/projects'], ['Notes', '/notes'], ['About', '/about'],
];
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Home">~/blog</a>
    <nav aria-label="Primary navigation">
      {nav.map(([label, href]) => <a class:list={[{ active: pathname === href || pathname.startsWith(`${href}/`) }]} href={href}>{label}</a>)}
    </nav>
    <div class="theme-picker" role="group" aria-label="页面主题">
      <button type="button" data-theme-choice="light" aria-pressed="false">浅色</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">深色</button>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('[data-theme-choice]');
    const updateSelection = () => buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === document.documentElement.dataset.theme));
    });
    updateSelection();
    buttons.forEach((button) => button.addEventListener('click', () => {
      const theme = button.dataset.themeChoice;
      document.documentElement.dataset.theme = theme;
      // Theme switching still works when browser storage is unavailable.
      try { localStorage.setItem('theme', theme); } catch {}
      updateSelection();
    }));
  })();
</script>
