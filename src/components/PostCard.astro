---
import type { Post } from '../lib/posts';
import { formatDate, readingTime } from '../lib/posts';
const { post } = Astro.props as { post: Post };
---
<article class="post-card">
  <div class="post-meta">{formatDate(post.data.date)} · {readingTime(post.body ?? '')} min read · {post.data.category}</div>
  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <div class="tag-list">{post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>
</article>
